# Copy this file to `.env` and fill in your (rotated) Orkes Conductor credentials.
# These stay SERVER-SIDE — the browser never sees them.

CONDUCTOR_SERVER_URL=https://<your-tenant>.orkesconductor.io/api

# Create an Application key/secret in Orkes: Access Control -> Applications.
# Rotate the previously-exposed key before using it here.
CONDUCTOR_AUTH_KEY=your-application-key-id
CONDUCTOR_AUTH_SECRET=your-application-secret

# Workflow this UI drives (defaults shown)
WORKFLOW_NAME=credit_scoring_approval
WORKFLOW_VERSION=1
REVIEW_TASK_REF=manual_review_ref

# Local proxy port
PORT=4000
